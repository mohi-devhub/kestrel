# Ports 5433/6380, not the defaults — a native postgres/redis on the host already
# holds 5432/6379. See deploy/docker-compose.yml.
DATABASE_URL=postgresql+psycopg://foundry:foundry@localhost:5433/foundry
REDIS_URL=redis://localhost:6380/0
KUBECONFIG_PATH=../deploy/kubeconfig/host.yaml
DEFAULT_NAMESPACE=default
ADMIN_TOKEN=change-me
