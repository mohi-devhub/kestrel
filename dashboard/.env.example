# Server-side only — none of these reach the browser. The dashboard makes every
# control-plane call from the Next.js server, which is why the control plane needs
# no CORS configuration and no credential ever ships to the client.
KESTREL_API_URL=http://127.0.0.1:8000
KESTREL_ADMIN_TOKEN=dev-admin-token
PROMETHEUS_URL=http://127.0.0.1:9090
